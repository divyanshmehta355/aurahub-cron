# Server Port (Render sets this automatically via $PORT)
PORT=4000

# MongoDB Connection String (Atlas mongodb+srv or direct)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/db_two

# Redis Connection String (Upstash or Redis Cloud)
REDIS_URL=redis://default:password@host:port

# Streamtape Proxy Worker URL
AURA_API_BASE_URL=https://aurahub-api-hono.ashwathama249.workers.dev

# Streamtape Upload Folder ID
UPLOAD_FOLDER_ID=QU3yuiRZZFw

# Secret token for triggering cron via HTTP (x-cron-key header or ?key= query)
CRON_SECRET=aurahub_cron_secret_key_2026

# Aging threshold in minutes (e.g. 60 for 1 hr, 108000 for 75 days)
AGING_MINUTES_THRESHOLD=60

# Max candidate videos to clone per cycle
MAX_CLONES_PER_RUN=5

# Optional: internal background ticker in hours (0 = disabled, use external cron-job.org)
AUTO_CLONE_INTERVAL_HOURS=0
