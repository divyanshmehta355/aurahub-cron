# Server Port (Render sets this automatically)
PORT=4000
NODE_ENV=production

# Aurahub MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/aurahub?retryWrites=true&w=majority

# Aurahub Redis Connection URL
REDIS_URL=rediss://default:<password>@<host>:<port>

# Aura Proxy API & Streamtape Folder
AURA_API_BASE_URL=https://aurahub-api.ashwathama249.workers.dev
UPLOAD_FOLDER_ID=

# Authorization Token for cron-job.org
CRON_SECRET=set_a_random_secure_token_here

# Video Age Threshold to Trigger Clone (in days, default: 75)
AGING_DAYS_THRESHOLD=75

# Max Videos to Clone per Single Cron Execution (default: 5)
MAX_CLONES_PER_RUN=5
